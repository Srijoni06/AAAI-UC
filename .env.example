# LLM backend: "local" (Ollama, default, used for all dev/testing) or "gemini"
LLM_BACKEND=local

# Ollama (used when LLM_BACKEND=local)
OLLAMA_HOST=http://localhost:11434
# Override the judge model only (agents stay on OLLAMA_AGENT_MODEL's default,
# llama3.1:8b), e.g. a larger local model for better contradiction detection:
# OLLAMA_JUDGE_MODEL=qwen2.5:14b

# Gemini (used when LLM_BACKEND=gemini)
GEMINI_API_KEY=your-gemini-api-key

# Response cache: set to 0 to disable (default: on)
LLM_CACHE=1

# Judge role only (detector NLI + reconciler): "same" (default, follow LLM_BACKEND),
# "local" or "gemini". Lets agents stay on local Ollama while a stronger model judges.
# Needs GEMINI_API_KEY when set to gemini.
# JUDGE_BACKEND=gemini
